df["ret_past"] = df["close"].pct_change()

if "volume" in df.columns:
    df["volume_price_corr"] = (
        df["volume"]
        .rolling(window, min_periods=max(5, window // 3))
        .corr(df["ret_past"])
        .shift(1)
    )

df["volume_price_corr_z"] = rolling_zscore(df["volume_price_corr"], window=200)
