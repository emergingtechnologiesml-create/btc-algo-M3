def volume_spike_summary(flags: pd.Series):
    total = len(flags)
    spikes = int(flags.sum())
    ratio  = spikes / total if total else 0
    print(f"[VOLUME-SPIKE] {spikes}/{total} bars ({ratio:.2%})")
